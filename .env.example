# LUNAR.MP3 environment configuration
# Copy this file to .env and fill in real values - never commit .env.

VITE_SPOTIFY_CLIENT_ID=

# Optional - lyrics chain. lrclib.net needs no key and is
# tried first; Musixmatch is an optional preview-only fallback used
# only if you set this. Leave blank to skip it entirely.
VITE_MUSIXMATCH_API_KEY=
